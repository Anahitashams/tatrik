# Copy this file to .env.local and fill in your Kavenegar credentials to
# send real verification-code SMS messages (see lib/kavenegar.js). Without
# these set, OTP codes are shown on-screen instead of being texted, so the
# login/signup flow still works end-to-end for local development.

# Required - from your Kavenegar panel (https://panel.kavenegar.com)
KAVENEGAR_API_KEY=

# Optional - a specific sender line number from your Kavenegar panel.
# Leave empty to use your account's default line.
KAVENEGAR_SENDER=
